    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
