{
  "name": "lifeconnect-server",
  "version": "1.0.0",
  "description": "Life Connect API server - Blood Donation + Medicine Share for Tamil Nadu",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
